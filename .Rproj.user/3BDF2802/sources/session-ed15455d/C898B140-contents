fix_nonascii <- function(path) {
  L <- readLines(path, warn = FALSE, encoding = "UTF-8")   # encoding= matters on Windows
  L <- gsub("\u2500", "-",  L)   # box-drawing line  -> hyphen (length-preserving dividers)
  L <- gsub("\u2014", "--", L)   # em dash           -> --
  L <- gsub("\u2192", "->", L)   # right arrow       -> ->
  con <- file(path, open = "wb") # binary + explicit \n keeps LF line-endings (no CRLF)
  writeLines(L, con, sep = "\n", useBytes = TRUE)
  close(con)
  invisible(L)
}

