# Verify new code
body_text <- deparse(body(curveRbayes::fit_calibration_bayes))
cat("Has multiplate:", any(grepl("calibration_result_multiplate", body_text)), "\n")
library(curveRcore)
library(curveRfreq)
library(curveRbayes)
# Verify new code
body_text <- deparse(body(curveRbayes::fit_calibration_bayes))
cat("Has multiplate:", any(grepl("calibration_result_multiplate", body_text)), "\n")
# Quick check
library(curveRcore); library(curveRfreq); library(curveRbayes)
data("bead_assay_example", package = "curveRcore")
std_raw <- bead_assay_example$standards[
bead_assay_example$standards$curve_id %in% c(1, 2, 3), ]
prepped <- preprocess_standards(
data = std_raw,
antigen_settings = list(standard_curve_concentration = 10000),
response_variable = "mfi", independent_variable = "concentration",
is_log_response = TRUE, is_log_independent = TRUE, apply_prozone = TRUE
)
samples <- bead_assay_example$samples[
bead_assay_example$samples$curve_id %in% c(1, 2, 3), ]
bayes_result <- fit_calibration_bayes(
standards = prepped$data, samples = samples,
response_var = "mfi", std_curve_conc = 10000,
model_names = c("logistic4", "gompertz4"),
chains = 4, warmup = 1000, sampling = 1000, seed = 42
)
# Verify structure matches freq
cat("Class:", class(bayes_result), "\n")
cat("Plates:", names(bayes_result$plates), "\n")
cat("Grid rows per plate:", sapply(bayes_result$plates, function(p) nrow(p$grid)), "\n")
cat("Samples per plate:", sapply(bayes_result$plates, function(p)
if(!is.null(p$samples)) nrow(p$samples) else 0), "\n")
# Summary table still works
summary_table_bayes(bayes_result)
# Per-curve comparison works
freq_result <- fit_calibration_freq_multiplate(
standards = prepped$data, samples = samples,
response_var = "mfi", std_curve_conc = 10000
)
freq_c1  <- freq_result$plates[["1"]]
bayes_c1 <- bayes_result$plates[["1"]]
grid_comp <- compare_calibrations(freq_c1, bayes_c1)
cat("\npcov correlation:", cor(grid_comp$frequentist_pcov,
grid_comp$bayesian_pcov, use="complete.obs"), "\n")
# =============================================================================
# diagnose_freq_pcov.R
#
# Standalone diagnostic for the frequentist per-model pcov failure on
# logistic5 and loglogistic5.
#
# Run interactively from the curveRfreq project root, or source() it.
# Requires: curveRcore, curveRfreq (both installed or loadable)
#
# Structure:
#   BLOCK 1 — Reproduce the exact vignette setup
#   BLOCK 2 — Inspect raw_fit objects per model
#   BLOCK 3 — Probe predict_grid_freq() step-by-step for each model
#   BLOCK 4 — Probe the gradient/delta-method internals directly
#   BLOCK 5 — Summary table of what is and isn't working
# =============================================================================
library(curveRcore)
library(curveRfreq)
# ── BLOCK 1: Reproduce the vignette data and fit ──────────────────────────────
data("bead_assay_example", package = "curveRcore")
std_raw <- bead_assay_example$standards[
bead_assay_example$standards$curve_id %in% c(1, 2, 3), ]
prepped <- curveRcore::preprocess_standards(
data                 = std_raw,
antigen_settings     = list(standard_curve_concentration = 10000),
response_variable    = "mfi",
independent_variable = "concentration",
is_log_response      = TRUE,
is_log_independent   = TRUE,
apply_prozone        = TRUE
)
standards <- prepped$data
freq_result <- fit_calibration_freq_multiplate(
standards      = standards,
samples        = NULL,
response_var   = "mfi",
model_names    = c("logistic4", "logistic5", "gompertz4", "loglogistic5"),
is_log_response    = TRUE,
is_log_independent = TRUE,
std_curve_conc = 10000,
verbose        = FALSE
)
cat("=== BLOCK 1: Fit complete ===\n")
cat("Plates:", paste(names(freq_result$plates), collapse = ", "), "\n\n")
# ── BLOCK 2: Inspect raw_fit objects per model ────────────────────────────────
# Key questions:
#   (a) What class is raw_fit for each model?
#   (b) Does summary(raw_fit)$sigma exist?
#   (c) Does summary(raw_fit)$parameters exist and contain all terms?
#   (d) Are the parameter names consistent with what predict_grid_freq() expects?
cat("=== BLOCK 2: raw_fit inspection per model (curve_id = 1) ===\n\n")
cr1 <- freq_result$plates[["1"]]
for (nm in names(cr1$ensemble)) {
ens <- cr1$ensemble[[nm]]
cat("--- Model:", nm, "---\n")
cat("  converged:", isTRUE(ens$converged), "\n")
if (!isTRUE(ens$converged)) {
cat("  [SKIPPED: not converged]\n\n")
next
}
raw <- ens$raw_fit
cat("  class(raw_fit):", paste(class(raw), collapse = ", "), "\n")
# Check sigma
sigma_val <- tryCatch(summary(raw)$sigma, error = function(e) {
cat("  ERROR getting sigma:", conditionMessage(e), "\n")
NA_real_
})
cat("  summary()$sigma:", sigma_val, "\n")
# Check parameter names from the fit
fit_params <- tryCatch(names(coef(raw)), error = function(e) {
cat("  ERROR getting coef():", conditionMessage(e), "\n")
character(0)
})
cat("  coef() names:", paste(fit_params, collapse = ", "), "\n")
# Check parameter names from stored parameters data frame
stored_params <- ens$parameters
cat("  stored params$term:", paste(stored_params$term, collapse = ", "), "\n")
cat("  stored params:\n")
print(stored_params[, c("term", "estimate", "std_error")])
cat("\n")
}
# ── BLOCK 3: Probe predict_grid_freq() step-by-step ──────────────────────────
# Attempt the exact vignette call for each model and capture any errors/NAs.
# Then inspect the resulting grid column by column.
cat("=== BLOCK 3: predict_grid_freq() probe per model (curve_id = 1) ===\n\n")
base_grid <- curveRcore::generate_prediction_grid(
std_curve_conc = 10000, n_grid = 200,
grid_min_conc = 1e-4, is_log_independent = TRUE)
cat("Base grid columns:", paste(names(base_grid), collapse = ", "), "\n\n")
model_grids <- list()
for (nm in names(cr1$ensemble)) {
ens <- cr1$ensemble[[nm]]
cat("--- Model:", nm, "---\n")
if (!isTRUE(ens$converged)) {
cat("  [SKIPPED: not converged]\n\n")
next
}
sigma_fit <- tryCatch(
summary(ens$raw_fit)$sigma,
error = function(e) {
cat("  WARNING: summary()$sigma failed:", conditionMessage(e), "\n")
0
}
)
cat("  sigma_fit used:", sigma_fit, "\n")
g <- tryCatch(
predict_grid_freq(
grid         = base_grid,
fit          = ens$raw_fit,
model_name   = nm,
se_response  = sigma_fit,
cv_x_max     = 150,
is_log_x     = TRUE
),
error = function(e) {
cat("  ERROR in predict_grid_freq():", conditionMessage(e), "\n")
NULL
}
)
if (is.null(g)) {
cat("  [predict_grid_freq returned NULL due to error]\n\n")
next
}
model_grids[[nm]] <- g
# Summarise key columns
cols_to_check <- c("predicted_response", "predicted_concentration",
"se_concentration", "pcov", "pcov_rmse", "pcov_pass")
for (col in cols_to_check) {
if (col %in% names(g)) {
vals <- g[[col]]
n_na   <- sum(is.na(vals))
n_fin  <- sum(is.finite(vals))
rng    <- if (n_fin > 0) range(vals, na.rm = TRUE) else c(NA, NA)
cat(sprintf("  %-25s  NA=%d  finite=%d  range=[%.4g, %.4g]\n",
col, n_na, n_fin, rng[1], rng[2]))
} else {
cat(sprintf("  %-25s  [COLUMN MISSING]\n", col))
}
}
cat("\n")
}
# ── BLOCK 4: Delta-method gradient probe ─────────────────────────────────────
# predict_grid_freq() internally calls make_inv_and_grad_fixed() (or similar)
# from curveRcore to get the gradient of the inverse function with respect to
# the response. For 5-parameter models this gradient also depends on g.
#
# We test the gradient functions directly to see if they return finite values
# for both 4- and 5-parameter models.
cat("=== BLOCK 4: Direct gradient probe ===\n\n")
# Test at a representative mid-range point
x_test <- 3.0   # log10(concentration) ~ 3
for (nm in names(cr1$ensemble)) {
ens <- cr1$ensemble[[nm]]
if (!isTRUE(ens$converged)) next
p  <- ens$parameters
pv <- stats::setNames(p$estimate, p$term)
cat("--- Model:", nm, "---\n")
cat("  params:", paste(names(pv), round(pv, 4), sep = "=", collapse = ", "), "\n")
# Forward model value at x_test
y_test <- tryCatch(
switch(nm,
logistic4    = curveRcore::logistic4(x_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
logistic5    = curveRcore::logistic5(x_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
gompertz4    = curveRcore::gompertz4(x_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
loglogistic5 = curveRcore::loglogistic5(x_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
NA_real_
),
error = function(e) { cat("  ERROR forward model:", conditionMessage(e), "\n"); NA_real_ }
)
cat("  forward model at x=", x_test, ":", y_test, "\n")
# Inverse at y_test
x_inv <- tryCatch(
switch(nm,
logistic4    = curveRcore::inv_logistic4(y_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
logistic5    = curveRcore::inv_logistic5(y_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
gompertz4    = curveRcore::inv_gompertz4(y_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
loglogistic5 = curveRcore::inv_loglogistic5(y_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
NA_real_
),
error = function(e) { cat("  ERROR inverse:", conditionMessage(e), "\n"); NA_real_ }
)
cat("  inverse at y=", round(y_test, 4), ":", x_inv,
"(should recover", x_test, ")\n")
# dy/dx at x_test (first derivative)
dydx_val <- tryCatch(
switch(nm,
logistic4    = curveRcore::dydx_logistic4(x_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
logistic5    = curveRcore::dydx_logistic5(x_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
gompertz4    = curveRcore::dydx_gompertz4(x_test, pv["a"], pv["b"],
pv["c"], pv["d"]),
loglogistic5 = curveRcore::dydx_loglogistic5(x_test, pv["a"], pv["b"],
pv["c"], pv["d"], pv["g"]),
NA_real_
),
error = function(e) { cat("  ERROR dydx:", conditionMessage(e), "\n"); NA_real_ }
)
cat("  dy/dx at x=", x_test, ":", dydx_val, "\n")
# dx/dy = 1 / (dy/dx) — this is what the delta method uses
dxdy_val <- if (is.finite(dydx_val) && abs(dydx_val) > 1e-12)
1 / dydx_val else NA_real_
cat("  dx/dy (= 1/(dy/dx)) :", dxdy_val, "\n")
# Gradient from curveRcore — this is what predict_grid_freq() uses internally
# make_inv_and_grad_fixed() returns a list with $inv and $grad functions
grad_fn <- tryCatch(
curveRcore::make_inv_and_grad_fixed(nm, fixed_a = NULL),
error = function(e) {
cat("  ERROR make_inv_and_grad_fixed():", conditionMessage(e), "\n")
NULL
}
)
if (!is.null(grad_fn)) {
cat("  make_inv_and_grad_fixed() returned: class =",
paste(class(grad_fn), collapse = ", "), "\n")
cat("  names:", paste(names(grad_fn), collapse = ", "), "\n")
# Try calling grad_fn$grad at y_test with the parameter vector
param_vec <- pv[!is.na(pv)]  # drop NA (e.g. g for 4-param models)
grad_val <- tryCatch(
grad_fn$grad(y_test, param_vec),
error = function(e) {
cat("  ERROR calling grad_fn$grad():", conditionMessage(e), "\n")
NULL
}
)
cat("  grad_fn$grad(y_test, params):", paste(round(grad_val, 6), collapse = ", "), "\n")
}
cat("\n")
}
# ── BLOCK 5: Summary table ────────────────────────────────────────────────────
# Collate the key facts: converged, pcov present, pcov finite, pcov range.
cat("=== BLOCK 5: Summary across all models and curve_ids ===\n\n")
summary_rows <- list()
for (cid in names(freq_result$plates)) {
cr <- freq_result$plates[[cid]]
for (nm in names(cr$ensemble)) {
ens <- cr$ensemble[[nm]]
converged <- isTRUE(ens$converged)
# Try to compute the grid for this model
if (converged) {
sigma_fit <- tryCatch(summary(ens$raw_fit)$sigma, error = function(e) 0)
g_test <- tryCatch({
bg <- curveRcore::generate_prediction_grid(
std_curve_conc = 10000, n_grid = 50,
grid_min_conc = 1e-4, is_log_independent = TRUE)
predict_grid_freq(
grid = bg, fit = ens$raw_fit, model_name = nm,
se_response = sigma_fit, cv_x_max = 150, is_log_x = TRUE)
}, error = function(e) NULL)
if (!is.null(g_test)) {
n_pcov_finite  <- sum(is.finite(g_test$pcov))
n_pcov_na      <- sum(is.na(g_test$pcov))
n_pcov_pass    <- if ("pcov_pass" %in% names(g_test)) sum(g_test$pcov_pass, na.rm = TRUE) else NA
grid_error     <- "none"
} else {
n_pcov_finite  <- NA
n_pcov_na      <- NA
n_pcov_pass    <- NA
grid_error     <- "predict_grid_freq FAILED"
}
} else {
n_pcov_finite <- NA; n_pcov_na <- NA; n_pcov_pass <- NA
grid_error <- "not converged"
sigma_fit  <- NA
}
summary_rows[[length(summary_rows) + 1]] <- data.frame(
curve_id      = cid,
model         = nm,
converged     = converged,
sigma_fit     = round(if (is.numeric(sigma_fit)) sigma_fit else NA, 5),
n_pcov_finite = n_pcov_finite,
n_pcov_na     = n_pcov_na,
n_pcov_pass   = n_pcov_pass,
grid_error    = grid_error,
stringsAsFactors = FALSE
)
}
}
summary_df <- do.call(rbind, summary_rows)
print(summary_df, row.names = FALSE)
# ── BLOCK 6: NLS formula inspection for 5-param models ───────────────────────
# predict_grid_freq() uses build_nls_formulas() to know the parameter names.
# If the formula for logistic5/loglogistic5 uses a different variable name
# for g (e.g. "g" vs something else), the coef() lookup inside the delta
# method will fail silently.
cat("\n=== BLOCK 6: NLS formula inspection ===\n\n")
for (nm in c("logistic4", "logistic5", "gompertz4", "loglogistic5")) {
fmla <- tryCatch(
curveRcore::build_nls_formulas(nm, fixed_a = NULL),
error = function(e) {
cat("ERROR build_nls_formulas(", nm, "):", conditionMessage(e), "\n")
NULL
}
)
if (!is.null(fmla)) {
cat("model:", nm, "\n")
cat("  formula:", deparse(fmla[[1]]), "\n\n")
}
}
# ── BLOCK 7: coef() vs parameters$term cross-check ───────────────────────────
# If the NLS fit was run with a formula that uses different parameter names
# than what make_inv_and_grad_fixed() expects, the gradient evaluation
# will receive a wrongly-named vector and may return NA or 0 silently.
cat("=== BLOCK 7: coef() names vs stored parameters$term vs gradient expectations ===\n\n")
for (nm in names(cr1$ensemble)) {
ens <- cr1$ensemble[[nm]]
if (!isTRUE(ens$converged)) next
coef_names   <- tryCatch(names(coef(ens$raw_fit)), error = function(e) character(0))
stored_terms <- ens$parameters$term
grad_obj <- tryCatch(
curveRcore::make_inv_and_grad_fixed(nm, fixed_a = NULL),
error = function(e) NULL
)
# What parameter order/names does the gradient function expect?
# Infer from formals of dydx_* functions
dydx_fn_name <- paste0("dydx_", nm)
dydx_fn <- tryCatch(get(dydx_fn_name, envir = asNamespace("curveRcore")),
error = function(e) NULL)
expected_params <- if (!is.null(dydx_fn))
setdiff(names(formals(dydx_fn)), "x") else "unknown"
cat("model:", nm, "\n")
cat("  coef() names     :", paste(coef_names,   collapse = ", "), "\n")
cat("  stored terms     :", paste(stored_terms,  collapse = ", "), "\n")
cat("  dydx_* expects   :", paste(expected_params, collapse = ", "), "\n")
# Flag any mismatch
if (!setequal(coef_names, stored_terms)) {
cat("  *** MISMATCH: coef() names != stored terms ***\n")
}
if (!is.null(dydx_fn) && !all(expected_params %in% coef_names)) {
missing <- setdiff(expected_params, coef_names)
cat("  *** MISSING in coef(): ", paste(missing, collapse = ", "), " ***\n")
}
cat("\n")
}
cat("=== Diagnosis complete ===\n")
.rs.restartR()
devtools::document()
devtools::install()
